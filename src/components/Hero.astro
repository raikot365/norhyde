---
import { SITE, formatARS, buildWhatsAppUrl } from '../data/site';
import { CATALOG_LINES, TOTAL_PRODUCTS } from '../data/catalog';

const whatsappIntroUrl = buildWhatsAppUrl(
  '¡Hola Norhydé! Estuve viendo el catálogo y me gustaría hacer una consulta sobre los licores artesanales.'
);
const largeCombo2 = SITE.combos.find((c) => c.format === 'botella' && c.qty === 2);
const miniCombo2 = SITE.combos.find((c) => c.format === 'botellita' && c.qty === 2);
const miniCombo3 = SITE.combos.find((c) => c.format === 'botellita' && c.qty === 3);
---

<section id="inicio" class="hero">
  <div class="hero__backdrop" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__content">
      <div class="hero__seal-row">
        <span class="eyebrow">
          <span class="eyebrow__dot" aria-hidden="true"></span>
          {SITE.origin} · {CATALOG_LINES.length} líneas · {TOTAL_PRODUCTS} sabores
        </span>
      </div>

      <h1 class="hero__title">{SITE.heroTitle}</h1>

      <p class="hero__subtitle">{SITE.heroSubtitle}</p>

      <div class="hero__formats">
        <div class="format-chip">
          <span class="format-chip__title">{SITE.formats.botella.label}</span>
          <span class="format-chip__meta">{SITE.formats.botella.capacity}</span>
          <span class="format-chip__price">{formatARS(SITE.formats.botella.price)}</span>
        </div>
        <div class="format-chip">
          <span class="format-chip__title">{SITE.formats.botellita.label}</span>
          <span class="format-chip__meta">{SITE.formats.botellita.capacity}</span>
          <span class="format-chip__price">{formatARS(SITE.formats.botellita.price)}</span>
        </div>
        {largeCombo2 && miniCombo2 && miniCombo3 && (
          <div class="format-chip format-chip--combo">
            <span class="format-chip__title">Combos</span>
            <span class="format-chip__price">
              Grandes {largeCombo2.qty} × {formatARS(largeCombo2.price)} · Botellitas{' '}
              {miniCombo2.qty} × {formatARS(miniCombo2.price)} · {miniCombo3.qty} ×{' '}
              {formatARS(miniCombo3.price)}
            </span>
          </div>
        )}
      </div>

      <div class="hero__actions">
        <a href="#catalogo" class="btn btn-primary">
          Explorar catálogo
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 5v14" />
            <path d="m19 12-7 7-7-7" />
          </svg>
        </a>

        <a
          href={whatsappIntroUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="wa-icon" aria-hidden="true">
            <path d="M12.03 2C6.5 2 2.02 6.48 2.02 12c0 1.77.46 3.5 1.34 5.02L2 22l5.12-1.34A9.96 9.96 0 0 0 12.03 22c5.52 0 10-4.48 10-10S17.55 2 12.03 2Zm5.83 14.12c-.25.7-1.45 1.34-2.01 1.42-.52.08-1.17.11-1.89-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5.01-4.37-5.16-4.57-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.6-.38.8-.38.2 0 .4 0 .58.01.19.01.44-.07.68.52.25.61.85 2.1.93 2.25.07.15.12.33.02.53-.1.2-.15.33-.3.5-.15.17-.32.39-.45.52-.15.15-.31.31-.13.62.18.3.79 1.31 1.7 2.12 1.17 1.04 2.15 1.36 2.46 1.51.3.15.48.13.66-.07.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.28.1 1.77.84 2.07.99.3.15.5.22.58.35.07.13.07.75-.18 1.45Z" />
          </svg>
          Consultar por WhatsApp
        </a>
      </div>
    </div>

    <div class="hero__visual" aria-label="Selección destacada de botellas Norhydé">
      <div class="showcase-stage">
        <figure class="showcase-card showcase-card--left">
          <div class="bottle-frame scallop-inner-rise" style="--scallop-rise-color: var(--bg-cream-soft);">
            <img
              src="/assets/botellas/pitanga.jpg"
              alt="Licor artesanal Norhydé de Pitanga en botella grande"
              class="bottle-photo"
            />
          </div>
          <figcaption class="showcase-card__caption">
            <strong>Pitanga</strong>
            <span>Frutos del Monte</span>
          </figcaption>
        </figure>

        <figure class="showcase-card showcase-card--center">
          <div class="bottle-frame scallop-inner-rise" style="--scallop-rise-color: var(--bg-cream-soft);">
            <img
              src="/assets/botellas/yerba.jpg"
              alt="Licor artesanal Norhydé de Yerba Mate en botella grande"
              class="bottle-photo"
            />
          </div>
          <figcaption class="showcase-card__caption">
            <strong>Yerba Mate</strong>
            <span>Tierra Colorada</span>
          </figcaption>
        </figure>

        <figure class="showcase-card showcase-card--right">
          <div class="bottle-frame scallop-inner-rise" style="--scallop-rise-color: var(--bg-cream-soft);">
            <img
              src="/assets/botellitas/butia.jpg"
              alt="Licor artesanal Norhydé de Butiá en formato botellita"
              class="bottle-photo"
            />
          </div>
          <figcaption class="showcase-card__caption">
            <strong>Butiá</strong>
            <span>Formato Botellita</span>
          </figcaption>
        </figure>

        <div class="hero-stamp scallop-seal" aria-hidden="true">
          <img
            src={SITE.logoPath}
            alt=""
            class="hero-stamp__img logo-blend"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 3.4rem 3.8rem;
    background: var(--bg-cream);
    overflow: hidden;
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 14% 20%, rgba(246, 229, 189, 0.72) 0%, transparent 45%),
      radial-gradient(circle at 86% 24%, rgba(214, 138, 98, 0.24) 0%, transparent 42%),
      radial-gradient(circle at 60% 90%, rgba(246, 229, 189, 0.55) 0%, transparent 45%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 2.5rem;
  }

  .eyebrow__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--terracotta);
  }

  .hero__title {
    margin-top: 0.75rem;
    font-size: clamp(2.15rem, 4.1vw, 3.35rem);
    font-weight: 700;
    color: var(--brown-deep);
  }

  .hero__subtitle {
    margin: 1.1rem 0 0;
    font-size: 1.08rem;
    color: var(--brown-medium);
    max-width: 54ch;
  }

  .hero__formats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .format-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    background: var(--bg-cream-soft);
    border: 1px solid var(--border-warm);
    box-shadow: 0 4px 12px -6px rgba(62, 36, 23, 0.14);
  }

  .format-chip__title {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--brown-deep);
  }

  .format-chip__meta {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--brown-medium);
    background: var(--bg-butter);
    padding: 0.14rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  .format-chip__price {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--terracotta-dark);
  }

  .format-chip--combo {
    background: var(--bg-butter-soft);
    border-color: var(--terracotta-soft);
  }

  .wa-icon {
    color: #258A4E;
    flex-shrink: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  /* Escenario visual con 3 botellas reales */
  .showcase-stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: end;
    gap: 0.95rem;
    padding: 1.25rem 0.5rem 0.5rem;
  }

  .showcase-card {
    margin: 0;
    background: var(--bg-cream-soft);
    border-radius: 24px 24px 18px 18px;
    overflow: hidden;
    border: 1.5px solid var(--border-warm);
    box-shadow: var(--shadow-card);
    transition: transform 0.25s ease;
  }

  .showcase-card--left {
    transform: translateY(-6px);
  }

  .showcase-card--center {
    transform: translateY(-22px) scale(1.04);
    z-index: 2;
    border-color: var(--terracotta-soft);
  }

  .showcase-card--right {
    transform: translateY(2px);
  }

  .showcase-card:hover {
    transform: translateY(-10px);
  }

  .showcase-card--center:hover {
    transform: translateY(-26px) scale(1.05);
  }

  .showcase-card__caption {
    position: relative;
    z-index: 3;
    margin-top: -2px;
    background: var(--bg-cream-soft);
    padding: 0.55rem 0.65rem 0.72rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .showcase-card__caption strong {
    font-family: var(--font-display);
    font-size: 0.94rem;
    color: var(--brown-deep);
  }

  .showcase-card__caption span {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--terracotta);
  }

  .hero-stamp {
    position: absolute;
    top: -0.25rem;
    right: 0.35rem;
    width: 78px;
    height: 78px;
    padding: 0.45rem;
    z-index: 4;
  }

  .hero-stamp__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }

    .hero {
      padding-block: 2.4rem 3rem;
    }

    .showcase-stage {
      max-width: 560px;
      margin-inline: auto;
      padding-top: 1.75rem;
    }
  }

  @media (max-width: 520px) {
    .showcase-stage {
      gap: 0.55rem;
    }

    .showcase-card--center {
      transform: translateY(-12px) scale(1.03);
    }

    .showcase-card__caption {
      padding: 0.45rem 0.35rem 0.55rem;
    }

    .showcase-card__caption strong {
      font-size: 0.82rem;
    }

    .showcase-card__caption span {
      font-size: 0.66rem;
    }

    .hero-stamp {
      width: 62px;
      height: 62px;
    }
  }
</style>
