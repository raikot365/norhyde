---
import { SITE, buildWhatsAppUrl } from '../data/site';

const whatsappFooterUrl = buildWhatsAppUrl(
  '¡Hola Norhydé! Quisiera hacer una consulta.'
);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <div class="footer-seal scallop-seal">
        <img src={SITE.logoPath} alt={`Logo ${SITE.brandName}`} class="logo-blend" />
      </div>
      <div>
        <strong class="site-footer__name">{SITE.brandName}</strong>
        <p class="site-footer__tag">{SITE.tagline} · {SITE.origin}</p>
      </div>
    </div>

    <nav class="site-footer__nav" aria-label="Navegación pie de página">
      <a href="#inicio">Inicio</a>
      <a href="#catalogo">Catálogo</a>
      <a href="#historia">Nuestra Historia</a>
      <a href="#formatos">Formatos</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <div class="site-footer__social" aria-label="Redes y contacto">
      <a
        href={whatsappFooterUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-social-btn footer-social-btn--wa"
        aria-label="WhatsApp de Norhydé"
        title="WhatsApp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.03 2C6.5 2 2.02 6.48 2.02 12c0 1.77.46 3.5 1.34 5.02L2 22l5.12-1.34A9.96 9.96 0 0 0 12.03 22c5.52 0 10-4.48 10-10S17.55 2 12.03 2Zm5.83 14.12c-.25.7-1.45 1.34-2.01 1.42-.52.08-1.17.11-1.89-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5.01-4.37-5.16-4.57-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.6-.38.8-.38.2 0 .4 0 .58.01.19.01.44-.07.68.52.25.61.85 2.1.93 2.25.07.15.12.33.02.53-.1.2-.15.33-.3.5-.15.17-.32.39-.45.52-.15.15-.31.31-.13.62.18.3.79 1.31 1.7 2.12 1.17 1.04 2.15 1.36 2.46 1.51.3.15.48.13.66-.07.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.28.1 1.77.84 2.07.99.3.15.5.22.58.35.07.13.07.75-.18 1.45Z" />
        </svg>
      </a>
      <a
        href={SITE.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-social-btn footer-social-btn--ig"
        aria-label={`Instagram ${SITE.instagramHandle}`}
        title={SITE.instagramHandle}
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
        </svg>
      </a>
    </div>

    <div class="site-footer__legal">
      <p>Beber con moderación. Prohibida su venta a menores de 18 años.</p>
      <p>© {new Date().getFullYear()} {SITE.brandName} — Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--brown-deep);
    color: var(--bg-cream);
    padding-block: 2.8rem 2.2rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .footer-seal {
    width: 58px;
    height: 58px;
    padding: 0.35rem;
    box-shadow: 0 0 0 3px rgba(248, 242, 231, 0.2);
  }

  .footer-seal img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--bg-butter);
    display: block;
  }

  .site-footer__tag {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    color: rgba(248, 242, 231, 0.78);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .site-footer__nav a {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--bg-butter-soft);
  }

  .site-footer__nav a:hover {
    color: var(--terracotta-soft);
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-social-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(248, 242, 231, 0.12);
    border: 1px solid rgba(248, 242, 231, 0.24);
    color: var(--bg-cream);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.16s ease, transform 0.16s ease;
  }

  .footer-social-btn:hover {
    transform: translateY(-2px);
  }

  .footer-social-btn--wa:hover {
    background: #258A4E;
    border-color: #258A4E;
  }

  .footer-social-btn--ig:hover {
    background: #C13584;
    border-color: #C13584;
  }

  .site-footer__legal {
    width: 100%;
    border-top: 1px solid rgba(248, 242, 231, 0.16);
    padding-top: 1.2rem;
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.8rem;
    color: rgba(248, 242, 231, 0.72);
  }

  .site-footer__legal p {
    margin: 0;
  }
</style>
