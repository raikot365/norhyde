---
import { SITE, formatARS } from '../data/site';
---

<div
  id="product-modal"
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-product-title"
  hidden
>
  <div class="modal-dialog">
    <div class="modal-header-band scallop-bottom-edge" style="--scallop-color: var(--bg-butter);">
      <span id="modal-line-badge" class="modal-line-badge">Línea Norhydé</span>
      <button
        type="button"
        id="modal-close-btn"
        class="modal-close-btn"
        aria-label="Cerrar detalle del producto"
      >
        ✕
      </button>
    </div>

    <div class="modal-body">
      <div class="modal-media-col">
        <div
          class="bottle-frame modal-bottle-frame scallop-inner-rise"
          style="--scallop-rise-color: var(--bg-cream-soft);"
        >
          <img
            id="modal-product-img"
            src=""
            alt=""
            class="bottle-photo"
            hidden
          />
          <div id="modal-product-placeholder" class="bottle-placeholder" hidden>
            <div class="bottle-placeholder__seal">
              <img src={SITE.logoPath} alt={`Sello ${SITE.brandName}`} />
            </div>
            <span id="modal-placeholder-flavor" class="bottle-placeholder__flavor">Sabor</span>
            <span class="bottle-placeholder__tag">Foto próximamente</span>
          </div>
        </div>
      </div>

      <div class="modal-info-col">
        <div class="modal-title-row">
          <h3 id="modal-product-title" class="modal-title">Sabor</h3>
          <span id="modal-unit-price" class="modal-unit-price">
            {formatARS(SITE.formats.botella.price)}
          </span>
        </div>
        <p id="modal-product-desc" class="modal-desc"></p>

        <div class="modal-serving-box">
          <span class="modal-serving-box__label">Sugerencia de servido</span>
          <p id="modal-serving-text" class="modal-serving-box__text"></p>
        </div>

        <div class="modal-control-group">
          <span class="modal-control-label">Elegí el formato</span>
          <div class="modal-format-options" role="group" aria-label="Formato de botella">
            <button type="button" class="modal-format-btn" data-modal-format="botella">
              <strong>{SITE.formats.botella.label}</strong>
              <span>
                {SITE.formats.botella.capacity} · {formatARS(SITE.formats.botella.price)}
              </span>
            </button>
            <button type="button" class="modal-format-btn" data-modal-format="botellita">
              <strong>{SITE.formats.botellita.label}</strong>
              <span>
                {SITE.formats.botellita.capacity} · {formatARS(SITE.formats.botellita.price)}
              </span>
            </button>
          </div>
        </div>

        <div class="modal-control-group modal-qty-row">
          <span class="modal-control-label">Cantidad</span>
          <div class="qty-stepper">
            <button type="button" id="modal-qty-minus" aria-label="Disminuir cantidad">−</button>
            <span id="modal-qty-value" aria-live="polite">1</span>
            <button type="button" id="modal-qty-plus" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>

        <p class="modal-stock-note">
          Consultar stock disponible · Elaboración artesanal según temporada e insumos.
        </p>

        <div class="modal-actions">
          <button type="button" id="modal-add-to-cart" class="btn btn-primary">
            Agregar al pedido
          </button>
          <a
            id="modal-whatsapp-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="wa-icon" aria-hidden="true">
              <path d="M12.03 2C6.5 2 2.02 6.48 2.02 12c0 1.77.46 3.5 1.34 5.02L2 22l5.12-1.34A9.96 9.96 0 0 0 12.03 22c5.52 0 10-4.48 10-10S17.55 2 12.03 2Zm5.83 14.12c-.25.7-1.45 1.34-2.01 1.42-.52.08-1.17.11-1.89-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5.01-4.37-5.16-4.57-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.6-.38.8-.38.2 0 .4 0 .58.01.19.01.44-.07.68.52.25.61.85 2.1.93 2.25.07.15.12.33.02.53-.1.2-.15.33-.3.5-.15.17-.32.39-.45.52-.15.15-.31.31-.13.62.18.3.79 1.31 1.7 2.12 1.17 1.04 2.15 1.36 2.46 1.51.3.15.48.13.66-.07.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.28.1 1.77.84 2.07.99.3.15.5.22.58.35.07.13.07.75-.18 1.45Z" />
            </svg>
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: rgba(38, 20, 11, 0.56);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow-y: auto;
  }

  .modal-backdrop[hidden] {
    display: none;
  }

  .modal-dialog {
    background: var(--bg-cream-soft);
    border: 1.5px solid var(--border-warm);
    border-radius: var(--radius-lg);
    width: min(100%, 840px);
    max-height: 92vh;
    overflow-y: auto;
    box-shadow: 0 28px 60px rgba(38, 20, 11, 0.35);
    animation: modalPop 0.2s ease-out;
  }

  @keyframes modalPop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .modal-header-band {
    background: var(--bg-butter);
    padding: 0.9rem 1.4rem 1.05rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .modal-line-badge {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--terracotta-dark);
  }

  .modal-close-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
    background: var(--bg-cream-soft);
    color: var(--brown-deep);
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .modal-close-btn:hover {
    background: var(--terracotta);
    color: #fffaf3;
    border-color: var(--terracotta);
  }

  .modal-body {
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
    gap: 1.75rem;
    padding: 1.75rem 1.5rem 1.6rem;
    align-items: start;
  }

  .modal-bottle-frame {
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-warm);
  }

  .modal-bottle-frame img[hidden],
  .modal-bottle-frame .bottle-placeholder[hidden] {
    display: none;
  }

  .modal-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .modal-title {
    font-size: clamp(1.65rem, 2.5vw, 2.15rem);
  }

  .modal-unit-price {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--terracotta-dark);
  }

  .wa-icon {
    color: #258A4E;
    flex-shrink: 0;
  }

  .modal-desc {
    margin: 0.7rem 0 0;
    color: var(--brown-medium);
    font-size: 0.97rem;
  }

  .modal-serving-box {
    margin-top: 1.1rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--bg-cream);
    border: 1px solid var(--border-warm);
  }

  .modal-serving-box__label {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--terracotta);
  }

  .modal-serving-box__text {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    color: var(--brown-deep);
  }

  .modal-control-group {
    margin-top: 1.15rem;
  }

  .modal-control-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--brown-muted);
    margin-bottom: 0.45rem;
  }

  .modal-format-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .modal-format-btn {
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--border-warm);
    background: var(--bg-cream);
    cursor: pointer;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    transition: all 0.16s ease;
  }

  .modal-format-btn strong {
    font-size: 0.88rem;
    color: var(--brown-deep);
  }

  .modal-format-btn span {
    font-size: 0.78rem;
    color: var(--brown-muted);
  }

  .modal-format-btn.is-active {
    background: var(--bg-butter);
    border-color: var(--terracotta);
    box-shadow: 0 4px 12px -6px rgba(197, 90, 23, 0.35);
  }

  .modal-qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-qty-row .modal-control-label {
    margin-bottom: 0;
  }

  .qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--border-warm);
    border-radius: var(--radius-pill);
    background: var(--bg-cream);
    overflow: hidden;
  }

  .qty-stepper button {
    width: 36px;
    height: 34px;
    border: none;
    background: transparent;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--brown-deep);
  }

  .qty-stepper button:hover {
    background: var(--bg-butter);
  }

  .qty-stepper span {
    min-width: 32px;
    text-align: center;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .modal-stock-note {
    margin: 0.95rem 0 0;
    padding: 0.55rem 0.78rem;
    border-radius: var(--radius-sm);
    background: var(--bg-butter-soft);
    border: 1px dashed var(--terracotta-soft);
    color: var(--terracotta-dark);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .modal-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin-top: 1.35rem;
  }

  @media (max-width: 720px) {
    .modal-body {
      grid-template-columns: 1fr;
      padding: 1.25rem;
    }

    .modal-bottle-frame {
      max-width: 280px;
      margin-inline: auto;
    }

    .modal-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
