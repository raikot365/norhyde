---
import { SITE } from '../data/site';
---

<header class="site-header scallop-bottom-edge" style="--scallop-color: var(--bg-cream-soft);">
  <div class="container site-header__inner">
    <a href="#inicio" class="brand-lockup" aria-label={`${SITE.brandName} — Inicio`}>
      <span class="brand-lockup__medallion">
        <img
          src={SITE.logoPath}
          alt={`Logo ${SITE.brandName}`}
          class="brand-lockup__logo logo-blend"
          width="48"
          height="48"
        />
      </span>
      <span class="brand-lockup__text">
        <span class="brand-lockup__name">{SITE.brandName}</span>
        <span class="brand-lockup__tagline">{SITE.tagline}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Navegación principal">
      <a href="#catalogo">Catálogo</a>
      <a href="#historia">Nuestra Historia</a>
      <a href="#formatos">Formatos</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        id="open-cart-btn"
        class="cart-trigger"
        aria-label="Abrir pedido para WhatsApp"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
          <path d="M3 6h18" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
        <span class="cart-trigger__label">Mi pedido</span>
        <span id="cart-count-badge" class="cart-trigger__badge" hidden>0</span>
      </button>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="mobile-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Abrir menú"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav-panel" class="mobile-nav" hidden>
    <div class="container mobile-nav__links">
      <a href="#catalogo" class="mobile-nav__link">Catálogo de Sabores</a>
      <a href="#historia" class="mobile-nav__link">Nuestra Historia</a>
      <a href="#formatos" class="mobile-nav__link">Formatos Disponibles</a>
      <a href="#contacto" class="mobile-nav__link">Contacto y Envíos</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--bg-cream-soft);
    border-bottom: 1px solid rgba(211, 180, 141, 0.35);
    box-shadow: 0 8px 22px -14px rgba(62, 36, 23, 0.22);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.65rem;
  }

  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .brand-lockup__medallion {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--bg-butter-soft);
    border: 1.5px solid var(--border-warm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
    flex-shrink: 0;
  }

  .brand-lockup__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }

  .brand-lockup__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-lockup__name {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 700;
    color: var(--terracotta);
  }

  .brand-lockup__tagline {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brown-muted);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.65rem;
  }

  .site-nav a {
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--brown-medium);
    transition: color 0.16s ease;
    position: relative;
  }

  .site-nav a:hover {
    color: var(--terracotta);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .cart-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--terracotta);
    color: #fffaf3;
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.58rem 1.05rem;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: 0 6px 14px -5px rgba(197, 90, 23, 0.5);
    transition: background-color 0.16s ease, transform 0.16s ease;
  }

  .cart-trigger:hover {
    background: var(--terracotta-dark);
    transform: translateY(-1px);
  }

  .cart-trigger__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding-inline: 0.38rem;
    border-radius: var(--radius-pill);
    background: var(--bg-butter);
    color: var(--brown-deep);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .cart-trigger__badge[hidden] {
    display: none;
  }

  .mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1.5px solid var(--border-warm);
    background: var(--bg-cream);
    color: var(--brown-deep);
    cursor: pointer;
  }

  .mobile-nav {
    border-top: 1px solid var(--border-warm);
    background: var(--bg-cream-soft);
    padding-block: 0.75rem 1rem;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav__links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mobile-nav__link {
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--brown-deep);
  }

  .mobile-nav__link:hover {
    background: var(--bg-butter-soft);
    color: var(--terracotta);
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
    }

    .mobile-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .cart-trigger__label {
      display: none;
    }

    .cart-trigger {
      padding: 0.58rem 0.85rem;
    }
  }
</style>
