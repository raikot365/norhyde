---
import { SITE, buildWhatsAppUrl } from '../data/site';

const whatsappDirectUrl = buildWhatsAppUrl(
  '¡Hola Norhydé! Quisiera recibir asesoramiento sobre sabores disponibles, precios y envíos.'
);
---

<section id="contacto" class="contact-section">
  <div class="container">
    <header class="contact-header">
      <span class="eyebrow">Atención personalizada</span>
      <h2>Pedidos, degustaciones y envíos</h2>
      <p>
        ¿Querés armar una caja degustación, pedir sabores para un evento o consultar por puntos de
        venta en Misiones? Escribinos y coordinamos tu pedido.
      </p>
    </header>

    <div class="contact-grid">
      <article class="contact-card scallop-bottom-edge" style="--scallop-color: var(--bg-cream-soft);">
        <div class="contact-card__icon contact-card__icon--wa" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.03 2C6.5 2 2.02 6.48 2.02 12c0 1.77.46 3.5 1.34 5.02L2 22l5.12-1.34A9.96 9.96 0 0 0 12.03 22c5.52 0 10-4.48 10-10S17.55 2 12.03 2Zm5.83 14.12c-.25.7-1.45 1.34-2.01 1.42-.52.08-1.17.11-1.89-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5.01-4.37-5.16-4.57-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.6-.38.8-.38.2 0 .4 0 .58.01.19.01.44-.07.68.52.25.61.85 2.1.93 2.25.07.15.12.33.02.53-.1.2-.15.33-.3.5-.15.17-.32.39-.45.52-.15.15-.31.31-.13.62.18.3.79 1.31 1.7 2.12 1.17 1.04 2.15 1.36 2.46 1.51.3.15.48.13.66-.07.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.28.1 1.77.84 2.07.99.3.15.5.22.58.35.07.13.07.75-.18 1.45Z" />
          </svg>
        </div>
        <h3>Pedidos por WhatsApp</h3>
        <p>
          Armá tu carrito desde el catálogo o escribinos directamente para consultar stock, combos
          y envíos.
        </p>
        <a
          href={whatsappDirectUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.03 2C6.5 2 2.02 6.48 2.02 12c0 1.77.46 3.5 1.34 5.02L2 22l5.12-1.34A9.96 9.96 0 0 0 12.03 22c5.52 0 10-4.48 10-10S17.55 2 12.03 2Zm5.83 14.12c-.25.7-1.45 1.34-2.01 1.42-.52.08-1.17.11-1.89-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5.01-4.37-5.16-4.57-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.6-.38.8-.38.2 0 .4 0 .58.01.19.01.44-.07.68.52.25.61.85 2.1.93 2.25.07.15.12.33.02.53-.1.2-.15.33-.3.5-.15.17-.32.39-.45.52-.15.15-.31.31-.13.62.18.3.79 1.31 1.7 2.12 1.17 1.04 2.15 1.36 2.46 1.51.3.15.48.13.66-.07.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.28.1 1.77.84 2.07.99.3.15.5.22.58.35.07.13.07.75-.18 1.45Z" />
          </svg>
          Escribir por WhatsApp
        </a>
      </article>

      <article class="contact-card scallop-bottom-edge" style="--scallop-color: var(--bg-cream-soft);">
        <div class="contact-card__icon contact-card__icon--ig" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
          </svg>
        </div>
        <h3>Comunidad en Instagram</h3>
        <p>
          Seguinos para conocer nuevas tandas estacionales, recetas de tragos y ferias donde
          participamos.
        </p>
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" class="ig-icon" aria-hidden="true">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
          </svg>
          {SITE.instagramHandle}
        </a>
      </article>

      <article class="contact-card scallop-bottom-edge" style="--scallop-color: var(--bg-cream-soft);">
        <div class="contact-card__icon contact-card__icon--ship" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" />
            <path d="M12 22V12" />
            <path d="m3.3 7 8.7 5 8.7-5" />
            <path d="m7.5 4.27 9 5.15" />
          </svg>
        </div>
        <h3>Envíos y Puntos de Venta</h3>
        <p>
          {SITE.locationNote} Consultá por embalaje protegido para encomiendas y compras por
          mayor.
        </p>
        <a href={`mailto:${SITE.email}`} class="btn btn-ghost">
          {SITE.email}
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background: var(--bg-butter-soft);
    padding-block: 3.8rem 4.6rem;
  }

  .contact-header {
    text-align: center;
    max-width: 62ch;
    margin: 0 auto 2.3rem;
  }

  .contact-header h2 {
    margin-top: 0.45rem;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
  }

  .contact-header p {
    margin: 0.7rem 0 0;
    color: var(--brown-medium);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .contact-card {
    background: var(--bg-cream-soft);
    border: 1.5px solid var(--border-warm);
    border-bottom: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    padding: 1.6rem 1.35rem 1.8rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    box-shadow: var(--shadow-soft);
  }

  .contact-card.scallop-bottom-edge::after {
    left: -1.5px;
    right: -1.5px;
  }

  .contact-card__icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--bg-butter);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-card__icon--wa {
    background: #E4F5EA;
    color: #258A4E;
  }

  .contact-card__icon--ig {
    background: #FBE9EB;
    color: #C13584;
  }

  .contact-card__icon--ship {
    background: var(--bg-butter);
    color: var(--terracotta-dark);
  }

  .ig-icon {
    color: #C13584;
    flex-shrink: 0;
  }

  .contact-card h3 {
    font-size: 1.22rem;
  }

  .contact-card p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--brown-muted);
    flex: 1;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
