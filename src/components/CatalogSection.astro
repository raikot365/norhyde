---
import { SITE, formatARS } from '../data/site';
import {
  CATALOG_LINES,
  PRODUCTS,
  TOTAL_PRODUCTS,
  PRODUCTS_WITH_PHOTO_COUNT,
} from '../data/catalog';

const lineCounts = CATALOG_LINES.map((line) => ({
  ...line,
  products: PRODUCTS.filter((p) => p.lineId === line.id),
}));
const largeCombo2 = SITE.combos.find((c) => c.format === 'botella' && c.qty === 2);
const miniCombo2 = SITE.combos.find((c) => c.format === 'botellita' && c.qty === 2);
const miniCombo3 = SITE.combos.find((c) => c.format === 'botellita' && c.qty === 3);
---

<section id="catalogo" class="catalog-section">
  <div class="container">
    <header class="catalog-header">
      <div>
        <span class="eyebrow">Colección completa · {TOTAL_PRODUCTS} sabores</span>
        <h2 class="catalog-header__title">Catálogo de Licores</h2>
        <p class="catalog-header__lead">
          Explorá nuestras {CATALOG_LINES.length} líneas artesanales. Podés alternar entre{' '}
          <strong>Botella grande</strong> y <strong>Botellita</strong> en cada sabor, ver sus notas
          de cata y armar tu pedido directo para enviarlo por WhatsApp.
        </p>
        <p class="stock-notice" role="note">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
          </svg>
          <span>{SITE.stockNotice}</span>
        </p>
      </div>
      <div class="catalog-summary-pill">
        <span>{PRODUCTS_WITH_PHOTO_COUNT} con fotografía</span>
        <span aria-hidden="true">·</span>
        <span>Nuevas fotos en camino</span>
      </div>
    </header>

    <!-- Banner de combos vigentes -->
    {largeCombo2 && miniCombo2 && miniCombo3 && (
      <div class="combo-promo-banner" role="note" aria-label="Promociones vigentes en combos">
        <div class="combo-promo-banner__badge">Combos Vigentes</div>
        <p class="combo-promo-banner__text">
          <strong>Sabores a elección:</strong>{' '}
          <span>
            Botellas grandes {largeCombo2.qty} por <strong>{formatARS(largeCombo2.price)}</strong>
          </span>
          <span aria-hidden="true">·</span>
          <span>
            Botellitas {miniCombo2.qty} por <strong>{formatARS(miniCombo2.price)}</strong> /{' '}
            {miniCombo3.qty} por <strong>{formatARS(miniCombo3.price)}</strong>
          </span>
          <span class="combo-promo-banner__auto">
            El descuento se aplica automáticamente en tu pedido.
          </span>
        </p>
      </div>
    )}

    <!-- Barra de búsqueda y filtros -->
    <div class="filter-panel scallop-bottom-edge" style="--scallop-color: var(--bg-cream-soft);">
      <div class="filter-panel__top">
        <div class="search-box">
          <svg
            class="search-box__icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            type="search"
            id="catalog-search"
            class="search-box__input"
            placeholder="Buscar sabor o ingrediente..."
            aria-label="Buscar licor por sabor o línea"
          />
          <button
            type="button"
            id="clear-search-btn"
            class="search-box__clear"
            aria-label="Limpiar búsqueda"
            hidden
          >
            ✕
          </button>
        </div>

        <div class="format-filters" role="group" aria-label="Filtrar por formato o fotografía">
          <button type="button" class="pill-filter is-active" data-format-filter="all">
            Todos
          </button>
          <button type="button" class="pill-filter" data-format-filter="botella">
            {SITE.formats.botella.label}
          </button>
          <button type="button" class="pill-filter" data-format-filter="botellita">
            {SITE.formats.botellita.label}
          </button>
          <button type="button" class="pill-filter" data-format-filter="with-photo">
            Con foto disponible
          </button>
        </div>
      </div>

      <div class="line-filters" role="group" aria-label="Filtrar por línea de licores">
        <button type="button" class="line-pill is-active" data-line-filter="all">
          Todas las líneas <span>({TOTAL_PRODUCTS})</span>
        </button>
        {
          lineCounts.map((line) => (
            <button type="button" class="line-pill" data-line-filter={line.id}>
              {line.name} <span>({line.products.length})</span>
            </button>
          ))
        }
      </div>

      <div class="filter-panel__status">
        <p id="catalog-results-count" class="results-count">
          Mostrando {TOTAL_PRODUCTS} de {TOTAL_PRODUCTS} sabores en {CATALOG_LINES.length} líneas
        </p>
        <button type="button" id="reset-filters-btn" class="reset-link" hidden>
          Restablecer filtros
        </button>
      </div>
    </div>

    <!-- Listado por líneas -->
    <div id="catalog-lines-container" class="lines-stack">
      {
        lineCounts.map((line) => (
          <section
            class="line-block"
            data-line-group={line.id}
            aria-labelledby={`line-title-${line.id}`}
          >
            <div
              class={`line-banner line-banner--${line.accentTone} scallop-bottom-edge`}
              style="--scallop-color: var(--bg-cream-soft);"
            >
              <div class="line-banner__content">
                <div class="line-banner__eyebrow-row">
                  <span class="line-banner__badge">{line.badge}</span>
                  <span class="line-banner__count">
                    {line.products.length} {line.products.length === 1 ? 'sabor' : 'sabores'}
                  </span>
                </div>
                <h3 id={`line-title-${line.id}`} class="line-banner__title">
                  {line.name}
                </h3>
                <p class="line-banner__desc">{line.description}</p>
              </div>
              <div class="line-banner__seal scallop-seal" aria-hidden="true">
                <img src={SITE.logoPath} alt="" class="logo-blend" />
              </div>
            </div>

            <div class="products-grid">
              {line.products.map((product) => {
                const activeImg = product.images[product.defaultFormat];
                const hasBotella = Boolean(product.images.botella);
                const hasBotellita = Boolean(product.images.botellita);
                const searchBlob = `${product.name} ${line.name} ${product.shortNote} ${product.description}`.toLowerCase();

                return (
                  <article
                    class="product-card"
                    data-product-id={product.id}
                    data-line-id={product.lineId}
                    data-name={product.name.toLowerCase()}
                    data-search={searchBlob}
                    data-has-botella={hasBotella ? 'true' : 'false'}
                    data-has-botellita={hasBotellita ? 'true' : 'false'}
                    data-img-botella={product.images.botella ?? ''}
                    data-img-botellita={product.images.botellita ?? ''}
                    data-active-format={product.defaultFormat}
                  >
                    <div
                      class="product-card__media bottle-frame scallop-inner-rise"
                      style="--scallop-rise-color: var(--bg-cream-soft);"
                    >
                      {activeImg ? (
                        <img
                          src={activeImg}
                          alt={`Licor artesanal Norhydé de ${product.name}`}
                          class="bottle-photo product-card__img"
                          loading="lazy"
                        />
                      ) : null}

                      <div class="bottle-placeholder product-card__placeholder" hidden={Boolean(activeImg)}>
                        <div class="bottle-placeholder__seal">
                          <img src={SITE.logoPath} alt={`Sello ${SITE.brandName}`} />
                        </div>
                        <span class="bottle-placeholder__flavor">{product.name}</span>
                        <span class="bottle-placeholder__tag">Foto próximamente</span>
                      </div>

                      <span class="product-card__format-flag" data-card-format-badge>
                        {SITE.formats[product.defaultFormat].shortLabel}
                      </span>
                    </div>

                    <div class="product-card__body">
                      <div class="card-format-switch" role="group" aria-label={`Elegir formato de ${product.name}`}>
                        <button
                          type="button"
                          class={`card-format-btn ${product.defaultFormat === 'botella' ? 'is-active' : ''}`}
                          data-card-format="botella"
                          aria-pressed={product.defaultFormat === 'botella' ? 'true' : 'false'}
                        >
                          Botella
                          {hasBotella && <span class="photo-dot" title="Foto disponible" aria-label="con foto" />}
                        </button>
                        <button
                          type="button"
                          class={`card-format-btn ${product.defaultFormat === 'botellita' ? 'is-active' : ''}`}
                          data-card-format="botellita"
                          aria-pressed={product.defaultFormat === 'botellita' ? 'true' : 'false'}
                        >
                          Botellita
                          {hasBotellita && <span class="photo-dot" title="Foto disponible" aria-label="con foto" />}
                        </button>
                      </div>

                      <div class="product-card__head">
                        <h4 class="product-card__title">{product.name}</h4>
                        <span class="product-card__price" data-card-price>
                          {formatARS(SITE.formats[product.defaultFormat].price)}
                        </span>
                      </div>
                      <p class="product-card__note">{product.shortNote}</p>

                      <div class="product-card__actions">
                        <button
                          type="button"
                          class="btn btn-secondary btn-sm"
                          data-open-modal={product.id}
                        >
                          Ver detalle
                        </button>
                        <button
                          type="button"
                          class="btn btn-primary btn-sm"
                          data-add-cart={product.id}
                        >
                          + Agregar
                        </button>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>

    <!-- Estado vacío -->
    <div id="catalog-empty-state" class="empty-state" hidden>
      <div class="empty-state__seal scallop-seal" aria-hidden="true">
        <img src={SITE.logoPath} alt="" class="logo-blend" />
      </div>
      <h3>No encontramos sabores con esos filtros</h3>
      <p>
        Probá con otro nombre o limpiá los filtros activos para recorrer toda la carta de
        Norhydé.
      </p>
      <button type="button" id="empty-reset-btn" class="btn btn-primary">
        Ver todos los sabores
      </button>
    </div>
  </div>
</section>

<style>
  .catalog-section {
    background: var(--bg-butter-soft);
    padding-block: 3.4rem 4.5rem;
  }

  .catalog-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .catalog-header__title {
    margin-top: 0.45rem;
    font-size: clamp(1.85rem, 3.2vw, 2.65rem);
  }

  .catalog-header__lead {
    margin: 0.65rem 0 0;
    color: var(--brown-medium);
    max-width: 64ch;
  }

  .stock-notice {
    margin: 0.75rem 0 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.44rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--bg-cream-soft);
    border: 1px dashed var(--terracotta-soft);
    color: var(--terracotta-dark);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .stock-notice svg {
    flex-shrink: 0;
  }

  .catalog-summary-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--bg-cream-soft);
    border: 1px solid var(--border-warm);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brown-medium);
  }

  .combo-promo-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.85rem 1.15rem;
    margin-bottom: 1.25rem;
    background: linear-gradient(90deg, var(--bg-butter) 0%, var(--bg-terracotta-tint) 100%);
    border: 1.5px solid var(--terracotta-soft);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  .combo-promo-banner__badge {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.28rem 0.72rem;
    border-radius: var(--radius-pill);
    background: var(--terracotta);
    color: #fffaf3;
    flex-shrink: 0;
  }

  .combo-promo-banner__text {
    margin: 0;
    font-size: 0.92rem;
    color: var(--brown-deep);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.55rem;
  }

  .combo-promo-banner__auto {
    font-size: 0.83rem;
    color: var(--brown-medium);
    font-weight: 600;
  }

  /* Panel de filtros festoneado */
  .filter-panel {
    background: var(--bg-cream-soft);
    border: 1.5px solid var(--border-warm);
    border-bottom: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    padding: 1.25rem 1.25rem 1.45rem;
    margin-bottom: 2.75rem;
    box-shadow: var(--shadow-soft);
  }

  .filter-panel.scallop-bottom-edge::after,
  .line-banner.scallop-bottom-edge::after {
    left: -1.5px;
    right: -1.5px;
  }

  .filter-panel__top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    align-items: center;
    justify-content: space-between;
  }

  .search-box {
    position: relative;
    flex: 1 1 320px;
  }

  .search-box__icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--terracotta);
    pointer-events: none;
  }

  .search-box__input {
    width: 100%;
    padding: 0.72rem 2.4rem 0.72rem 2.75rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border-warm);
    background: var(--bg-cream);
    color: var(--brown-deep);
    font-size: 0.94rem;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .search-box__input:focus {
    outline: none;
    border-color: var(--terracotta);
    background: #ffffff;
  }

  .search-box__clear {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    background: var(--bg-sand);
    color: var(--brown-deep);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .search-box__clear[hidden] {
    display: none;
  }

  .format-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pill-filter,
  .line-pill {
    border: 1.5px solid var(--border-warm);
    background: var(--bg-cream);
    color: var(--brown-medium);
    border-radius: var(--radius-pill);
    padding: 0.48rem 0.9rem;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .pill-filter:hover,
  .line-pill:hover {
    border-color: var(--terracotta-soft);
    background: var(--bg-butter-soft);
  }

  .pill-filter.is-active,
  .line-pill.is-active {
    background: var(--terracotta);
    color: #fffaf3;
    border-color: var(--terracotta);
  }

  .line-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.95rem;
    padding-top: 0.95rem;
    border-top: 1px dashed var(--border-warm);
  }

  .line-pill span {
    opacity: 0.8;
    font-size: 0.78rem;
  }

  .filter-panel__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .results-count {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brown-muted);
  }

  .reset-link {
    background: none;
    border: none;
    color: var(--terracotta-dark);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .reset-link[hidden] {
    display: none;
  }

  /* Líneas y banners festoneados */
  .lines-stack {
    display: flex;
    flex-direction: column;
    gap: 3.4rem;
  }

  .line-block[hidden] {
    display: none;
  }

  .line-banner {
    background: var(--bg-cream-soft);
    border: 1.5px solid var(--border-warm);
    border-bottom: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    padding: 1.35rem 1.5rem 1.55rem;
    margin-bottom: 1.8rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    box-shadow: var(--shadow-soft);
  }

  .line-banner--terracotta {
    border-top: 4px solid var(--terracotta);
  }

  .line-banner--amber {
    border-top: 4px solid #D99B26;
  }

  .line-banner--herb {
    border-top: 4px solid #6E7E46;
  }

  .line-banner--cacao {
    border-top: 4px solid #7C4B2C;
  }

  .line-banner__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .line-banner__badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.22rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--bg-butter);
    color: var(--terracotta-dark);
  }

  .line-banner__count {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--brown-muted);
  }

  .line-banner__title {
    margin-top: 0.45rem;
    font-size: clamp(1.45rem, 2.3vw, 1.95rem);
  }

  .line-banner__desc {
    margin: 0.45rem 0 0;
    color: var(--brown-medium);
    max-width: 72ch;
    font-size: 0.96rem;
  }

  .line-banner__seal {
    flex-shrink: 0;
    padding: 0.4rem;
  }

  .line-banner__seal img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }

  /* Grilla de productos */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.35rem;
  }

  .product-card {
    background: var(--bg-cream-soft);
    border: 1.5px solid var(--border-warm);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-soft);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .product-card[hidden] {
    display: none;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
    border-color: var(--terracotta-soft);
  }

  .product-card:hover .bottle-photo {
    transform: scale(1.11);
  }

  .product-card__placeholder[hidden] {
    display: none;
  }

  .product-card__format-flag {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 3;
    padding: 0.24rem 0.62rem;
    border-radius: var(--radius-pill);
    background: rgba(253, 249, 242, 0.9);
    border: 1px solid rgba(211, 180, 141, 0.7);
    color: var(--brown-deep);
    font-size: 0.72rem;
    font-weight: 700;
    backdrop-filter: blur(4px);
  }

  .product-card__body {
    position: relative;
    z-index: 3;
    margin-top: -2px;
    background: var(--bg-cream-soft);
    padding: 0.85rem 1rem 1.05rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-format-switch {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    padding: 0.22rem;
    background: var(--bg-cream);
    border: 1px solid var(--border-warm);
    border-radius: var(--radius-pill);
    margin-bottom: 0.72rem;
  }

  .card-format-btn {
    border: none;
    background: transparent;
    color: var(--brown-muted);
    font-size: 0.77rem;
    font-weight: 700;
    padding: 0.34rem 0.55rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .card-format-btn.is-active {
    background: var(--bg-butter);
    color: var(--brown-deep);
    box-shadow: 0 2px 6px rgba(62, 36, 23, 0.08);
  }

  .photo-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--terracotta);
    display: inline-block;
  }

  .product-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .product-card__title {
    font-size: 1.16rem;
    color: var(--brown-deep);
  }

  .product-card__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--terracotta-dark);
    white-space: nowrap;
  }

  .product-card__note {
    margin: 0.38rem 0 1rem;
    font-size: 0.87rem;
    color: var(--brown-muted);
    line-height: 1.48;
    flex: 1;
  }

  .product-card__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
  }

  .btn-sm {
    padding: 0.56rem 0.7rem;
    font-size: 0.82rem;
  }

  .empty-state {
    background: var(--bg-cream-soft);
    border: 1.5px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 3rem 1.5rem;
    text-align: center;
